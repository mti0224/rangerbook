RANGERBOOK_AUTH_DB=/home/ubuntu/rangerbook-auth/rangerbook_auth.db
RANGERBOOK_ALLOWED_ORIGINS=https://rangerbook.warmycat.com
RANGERBOOK_SESSION_DAYS=7
RANGERBOOK_SESSION_COOKIE=__Host-rangerbook_session
RANGERBOOK_GUILDWAR_CORE=/home/ubuntu/rangerbook-scripts/collect_guildwar_usage.py
RANGERBOOK_PLAYER_INDEX=/home/ubuntu/rangerbook-data/player_index.json
RANGERBOOK_PLAYER_QUERY_CACHE=/home/ubuntu/rangerbook-auth/player_lookup_cache.json

# GA4 aggregate metrics (numeric property ID, not G- measurement ID)
RANGERBOOK_GA4_PROPERTY_ID=
RANGERBOOK_TRAFFIC_CACHE_DIR=/home/ubuntu/rangerbook-auth/traffic-cache

# Do not enable until SES identity is verified and sandbox restrictions are lifted.
RANGERBOOK_EMAIL_ENABLED=0
RANGERBOOK_EMAIL_REQUIRED=0
RANGERBOOK_SES_REGION=ap-south-1
RANGERBOOK_SES_FROM=no-reply@warmycat.com
RANGERBOOK_EMAIL_ACTION_BASE=https://rangerbook.warmycat.com/admin/
