# Preparation only: do not install/start until the runbook prerequisites pass.
[Unit]
Description=Rangerbook isolated membership acceptance
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rangerbook-member-stage-20261023/release
EnvironmentFile=/home/ubuntu/rangerbook-member-stage-20261023/acceptance/runtime.env
EnvironmentFile=/home/ubuntu/rangerbook-member-stage-20261023/acceptance/key.env
Environment=AWS_REGION=ap-south-1
ExecStart=/usr/local/bin/asm-exec -- /home/ubuntu/rangerbook-member-stage-20261023/venv/bin/python -m membership.stage.launch
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/rangerbook-member-stage-20261023/acceptance
InaccessiblePaths=/home/ubuntu/rangerbook-private /home/ubuntu/rangerbook-auth
InaccessiblePaths=-/home/ubuntu/rangerbook-scripts -/home/ubuntu/rangerbook-data -/home/ubuntu/rangerbook-cache
LimitCORE=0
Restart=no
# No [Install] section: operator-started temporary acceptance, not boot-enabled.
