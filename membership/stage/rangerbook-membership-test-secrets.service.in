[Unit]
Description=AWS secret provider for isolated Rangerbook acceptance
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rangerbook-member-stage-20261023/acceptance
Environment=AWS_REGION=ap-south-1
EnvironmentFile=/home/ubuntu/rangerbook-member-stage-20261023/acceptance/key.env
ExecStart=/home/ubuntu/rangerbook-member-stage-20261023/bin/aws-workload-credentials-provider sm start --config /home/ubuntu/rangerbook-member-stage-20261023/acceptance/secrets.toml
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
InaccessiblePaths=/home/ubuntu/rangerbook-private /home/ubuntu/rangerbook-auth
LimitCORE=0
Restart=no
