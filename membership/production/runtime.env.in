# Candidate only: service guards keep it inactive pending interface work and approval.
RANGERBOOK_STAGE=0
RANGERBOOK_MEMBERS_V2=1
RANGERBOOK_MEMBER_NAVIGATION=0
RANGERBOOK_AUTH_DB=/home/ubuntu/rangerbook-private/auth/rangerbook_auth.db
RANGERBOOK_PRIVATE_TEAM_DIR=/home/ubuntu/rangerbook-private/teams
RANGERBOOK_SESSION_COOKIE=__Host-rangerbook_session
RANGERBOOK_ALLOWED_ORIGINS=https://rangerbook.warmycat.com
RANGERBOOK_FRONTEND_URL=https://rangerbook.warmycat.com
RANGERBOOK_GOOGLE_REDIRECT_URI=https://rangerbook-auth.warmycat.com/auth/google/callback
RANGERBOOK_GOOGLE_CLIENT_ID={{resolve:secretsmanager:rangerbook/membership/google-oauth:SecretString:client_id}}
RANGERBOOK_GOOGLE_CLIENT_SECRET={{resolve:secretsmanager:rangerbook/membership/google-oauth:SecretString:client_secret}}
RANGERBOOK_TURNSTILE_SITE_KEY={{resolve:secretsmanager:rangerbook/membership/turnstile:SecretString:site_key}}
RANGERBOOK_TURNSTILE_SECRET={{resolve:secretsmanager:rangerbook/membership/turnstile:SecretString:secret_key}}
AWS_REGION=ap-south-1
AWS_SECRETS_MANAGER_AGENT_ENDPOINT=http://127.0.0.1:2774
RANGERBOOK_MAIL_ENABLED=0
RANGERBOOK_SES_CONFIGURATION_SET=rangerbook-membership
RANGERBOOK_FEEDBACK_QUEUE=https://sqs.ap-south-1.amazonaws.com/010421869571/rangerbook-membership-feedback
RANGERBOOK_FEEDBACK_TOPIC=arn:aws:sns:ap-south-1:010421869571:rangerbook-membership-feedback
RANGERBOOK_CUTOVER_APPROVAL=@ROOT@/review/CUTOVER_APPROVED
