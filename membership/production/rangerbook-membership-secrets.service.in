# Review only. No install/start before interface completion and explicit approval.
[Unit]
Description=Rangerbook independent membership secret provider
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=@ROOT@/review
Environment=AWS_REGION=ap-south-1
EnvironmentFile=@ROOT@/review/provider.env
ExecStartPre=/usr/bin/test -f @ROOT@/review/CUTOVER_APPROVED
ExecStartPre=/usr/bin/test ! -e @ROOT@/review/INTERFACE_PENDING
ExecStart=@ROOT@/bin/aws-workload-credentials-provider sm start --config @ROOT@/review/secrets.toml
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
LimitCORE=0
Restart=on-failure
RestartSec=3
