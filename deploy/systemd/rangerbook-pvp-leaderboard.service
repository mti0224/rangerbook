[Unit]
Description=Update LINE Rangers PvP leaderboards for all supported leagues
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rangerbook-pvp
ExecStart=/usr/bin/python3 /home/ubuntu/rangerbook-scripts/update_pvp_all_leagues.py --mode leaderboard
