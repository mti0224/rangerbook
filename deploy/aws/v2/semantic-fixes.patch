--- a/scripts/v2/test_semantic_audit.py
+++ b/scripts/v2/test_semantic_audit.py
@@ -0,0 +1,35 @@
+"""Regression tests use official-style facts, not recompiling an expected copy."""
+import unittest
+from scripts.v2_preview.normalize import skill
+from scripts.v2.raw_abilities import compile_abilities
+
+
+class SemanticAuditTests(unittest.TestCase):
+    def test_raw_subskills_expand_in_source_order_without_mutation(self):
+        parent={"skillCode":"parent","skillType":"DMG","subSkills":" second,first ",
+                "iconResourcePath":"skill.png"}
+        index={"parent":parent,"first":{"skillCode":"first","skillType":"STUN"},
+               "second":{"skillCode":"second","skillType":"BUFF","buffFactorType":"ATK"}}
+        result=skill(parent,9,index)
+        self.assertEqual([x["effectCode"] for x in result["effects"]],
+                         ["SKILLEFF_DMG","SKILLEFF_BUFF-ATK","SKILLEFF_STUN"])
+        self.assertEqual(result["icon"],"skill.png")
+        self.assertEqual(parent["subSkills"]," second,first ")
+
+    def test_missing_subskill_refuses_a_partial_result(self):
+        with self.assertRaisesRegex(ValueError,"Missing official sub-skill"):
+            skill({"skillCode":"parent","subSkills":"missing"},9,{})
+
+    def test_raw_children_cannot_be_silently_discarded(self):
+        with self.assertRaisesRegex(ValueError,"require a V2 skill index"):
+            skill({"skillCode":"parent","subSkills":"child"},9)
+
+    def test_ability_backspace_reference_is_removed(self):
+        row={"code":"ability","abilityType":"ABILITY","descriptionCode":"desc_\bfire",
+             "actionType":"NONE","aptitudeType":"NONE"}
+        result=compile_abilities([row],[])
+        self.assertEqual(result[0]["descriptionKey"],"ABILITY:desc_fire")
+
+
+if __name__=="__main__":
+    unittest.main()
