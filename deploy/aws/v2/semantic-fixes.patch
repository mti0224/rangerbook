+"""Validate the supported schema contract and all text bindings before promotion."""
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+from scripts.v2.audit import audit
+
+LANGUAGES=('zh_TW','en','th','jp')
+DATASETS={
+ 'rangers':'rangers','ranger-index':'rangers','equipment':'equipment',
+ 'equipment-name-index':'equipment','equipment-effects':'effects',
+ 'abilities':'abilities','labyrinth-artifacts':'artifacts','projectiles':'units',
+ 'resources':'assets',**{'enemies/'+x:'enemies' for x in ('hard','extreme','endless','event','advent','labyrinth')},
+ **{'stages/'+x:'stages' for x in ('hard','extreme','endless','labyrinth')}}
+FILES={x+'.json' for x in DATASETS}|{'manifest.json','translation-audit.json',
+ 'locales/official.json','locales/custom.json','locales/ui.json'}
+SCHEMA=Path(__file__).with_name('schemas')/'v2.json'
+
+
+def check(value,schema,defs,path='$'):
+    """Small explicit JSON Schema subset; unsupported keywords fail closed."""
+    allowed={'$ref','type','required','properties','additionalProperties','items',
+             'anyOf','enum','const','minLength','description'}
+    unknown=set(schema)-allowed
+    if unknown:raise ValueError('Unsupported schema keywords: '+str(sorted(unknown)))
+    if '$ref' in schema:
+        return check(value,defs[schema['$ref'].removeprefix('#/$defs/')],defs,path)
+    if 'anyOf' in schema:
+        for option in schema['anyOf']:
+            try:check(value,option,defs,path);return
+            except ValueError:pass
+        raise ValueError(path+': no schema alternative matched')
+    types=schema.get('type')
+    if types:
+        types=[types] if isinstance(types,str) else types
+        matches={'null':value is None,'string':isinstance(value,str),
+          'boolean':isinstance(value,bool),'integer':isinstance(value,int) and not isinstance(value,bool),
+          'number':isinstance(value,(float,int)) and not isinstance(value,bool) and math.isfinite(value),
+          'object':isinstance(value,dict),'array':isinstance(value,list)}
+        if not any(matches.get(t,False) for t in types):raise ValueError(path+': invalid type')
+    if 'enum' in schema and value not in schema['enum']:raise ValueError(path+': invalid enum')
+    if 'const' in schema and value!=schema['const']:raise ValueError(path+': invalid constant')
+    if isinstance(value,str) and len(value)<schema.get('minLength',0):raise ValueError(path+': empty value')
+    if isinstance(value,dict):
+        missing=set(schema.get('required',[]))-set(value)
+        if missing:raise ValueError(path+': missing fields '+str(sorted(missing)))
+        props=schema.get('properties',{})
+        if schema.get('additionalProperties') is False and set(value)-set(props):raise ValueError(path+': unknown fields')
+        for k,item in value.items():
+            if k in props:check(item,props[k],defs,path+'.'+k)
+            elif isinstance(schema.get('additionalProperties'),dict):check(item,schema['additionalProperties'],defs,path+'.'+k)
+    if isinstance(value,list) and 'items' in schema:
+        for i,item in enumerate(value):check(item,schema['items'],defs,f'{path}[{i}]')
+
+
+def validate(root,write_report=False):
+    root=Path(root)
+    actual={x.relative_to(root).as_posix() for x in root.rglob('*.json')}
+    if actual!=FILES:raise ValueError('V2 file allowlist mismatch: '+str(sorted(actual^FILES)))
+    spec=json.loads(SCHEMA.read_text(encoding='utf8'))
+    objects={}
+    for name in sorted(actual):
+        obj=json.loads((root/name).read_text(encoding='utf8'),parse_constant=lambda s:(_ for _ in ()).throw(ValueError('Nonfinite JSON '+s)))
+        objects[name]=obj
+        which='locale' if name.startswith('locales/') else 'manifest' if name=='manifest.json' else 'audit' if name=='translation-audit.json' else name.removesuffix('.json')
+        check(obj,spec['datasets'][which],spec['$defs'],name)
+    manifest=objects['manifest.json']
+    for name,field in DATASETS.items():
+        count=len(objects[name+'.json'][field])
+        if manifest['datasets'].get(name)!=count:raise ValueError('Manifest count mismatch: '+name)
+        identities={'rangers':('rangerCode',),'ranger-index':('rangerCode',),
+            'equipment':('equipCode',),'equipment-name-index':('equipCode',),
+            'equipment-effects':('attributeId',),'abilities':('abilityCode',),
+            'labyrinth-artifacts':('artifactCode','grade'),'resources':('assetGroup',)}
+        fields=identities.get(name,('enemyCode',) if name.startswith('enemies/') else
+                              ('stageId',) if name.startswith('stages/') else None)
+        if fields:
+            ids=[tuple(row.get(f) for f in fields) for row in objects[name+'.json'][field]]
+            if len(ids)!=len(set(ids)):raise ValueError('Duplicate V2 record identity: '+name)
+    result=audit(root)
+    # Missing source text remains explicit. It does not justify hiding a broken
+    # compiler binding, missing custom key, or untranslated semantic condition.
+    blocking=[f for f in result['findings'] if f['kind'] not in
+              ('empty_referenced_translation','control_character_key')]
+    if blocking:raise ValueError('V2 text/semantic binding failures: '+json.dumps(blocking[:8],ensure_ascii=False))
+    for kind in ('custom','ui'):
+        if any(result['catalogs'][kind]['missing'].values()):raise ValueError('Incomplete authored four-language '+kind+' catalog')
+    for kind in ('official','custom','ui'):
+        rows=objects['locales/'+kind+'.json']
+        expected={'total':len(rows),'withEnglish':sum(bool(r['en'].strip()) for r in rows),
+                  'withThai':sum(bool(r['th'].strip()) for r in rows),'withJapanese':sum(bool(r['jp'].strip()) for r in rows)}
+        if manifest['languageCatalogs'].get(kind)!=expected:raise ValueError('Manifest locale count mismatch: '+kind)
+    digest=hashlib.sha256()
+    for name in sorted(actual):
+        digest.update(name.encode());digest.update((root/name).read_bytes())
+    report={'status':'validated_with_explicit_official_gaps' if result['emptyReferencedKeys'] else 'validated',
+            'fileCount':len(actual),'contentSha256':digest.hexdigest(),
+            'translationCounts':result['catalogs'],'officialEmptyReferencedKeys':len(result['emptyReferencedKeys']),
+            'textBindingErrors':len(blocking)}
+    if write_report:
+        # Receipt is outside the public JSON allowlist, never a competing catalog.
+        (root/'.validated-release').write_text(json.dumps(report,ensure_ascii=False)+'\n')
+    return report
+
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--root',type=Path,required=True)
+    args=p.parse_args();print(json.dumps(validate(args.root,True),ensure_ascii=False,indent=2))
+
+if __name__=='__main__':main()
