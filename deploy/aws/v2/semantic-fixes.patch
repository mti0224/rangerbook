+"""V2-owned first-observed dates. Existing dates never change automatically."""
+from datetime import date, datetime
+import json
+from zoneinfo import ZoneInfo
+
+
+def prepare(records, previous=None, today=None):
+    metadata = dict(previous or {"schemaVersion": 1, "source": "v2_first_successful_record"})
+    if metadata.get("schemaVersion") != 1 or not isinstance(metadata.get("dates", {}), dict):
+        raise ValueError("Invalid V2 release-date metadata")
+    dates = dict(metadata.get("dates", {}))
+    for code, value in dates.items():
+        if not isinstance(code, str) or not isinstance(value, str) or date.fromisoformat(value).isoformat() != value:
+            raise ValueError("Invalid authored release date: " + str(code))
+    observed = today or datetime.now(ZoneInfo("Asia/Taipei")).date().isoformat()
+    if date.fromisoformat(observed).isoformat() != observed:
+        raise ValueError("Invalid recorded date")
+    for row in records:
+        code = row["rangerCode"]
+        dates.setdefault(code, observed)
+        row["releaseDate"] = dates[code]
+        row["releaseDateSource"] = "v2_author_record"
+    metadata.update(dates=dates, recordingPolicy="first_successful_v2_record_date", timezone="Asia/Taipei")
+    return (json.dumps(metadata, ensure_ascii=False, indent=2) + "\n").encode("utf8")
