+"""Failure and contention tests use temporary directories, never production."""
+import multiprocessing
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+from scripts.v2.release import promote,update_lock
+
+
+def attempt_lock(root,pipe):
+    try:
+        with update_lock(Path(root)):pipe.send("acquired")
+    except BlockingIOError:
+        pipe.send("blocked")
+    finally:
+        pipe.close()
+
+
+class ReleaseTests(unittest.TestCase):
+    def test_date_directory_failure_restores_release(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp);final=root/"v2";candidate=root/".v2-candidate-test"
+            final.mkdir();candidate.mkdir()
+            (final/"value").write_text("old");(candidate/"value").write_text("new")
+            target=root/"metadata/release-dates.json"
+            mkdir=Path.mkdir
+            def fail_directory(path,*args,**kwargs):
+                if path==target.parent:raise OSError("injected directory failure")
+                return mkdir(path,*args,**kwargs)
+            with patch.object(Path,"mkdir",fail_directory):
+                with self.assertRaisesRegex(OSError,"directory"):
+                    promote(candidate,final,metadata=(target,b"new dates"))
+            self.assertEqual((final/"value").read_text(),"old")
+            self.assertFalse(target.exists())
+
+    def test_date_commit_failure_restores_release_and_preserves_dates(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp);final=root/"v2";candidate=root/".v2-candidate-test"
+            final.mkdir();candidate.mkdir()
+            (final/"value").write_text("old");(candidate/"value").write_text("new")
+            target=root/"metadata/release-dates.json";target.parent.mkdir();target.write_bytes(b"old dates")
+            replace=Path.replace
+            def fail_dates(path,dst):
+                if Path(dst)==target:raise OSError("injected date commit failure")
+                return replace(path,dst)
+            with patch.object(Path,"replace",fail_dates):
+                with self.assertRaisesRegex(OSError,"date commit"):
+                    promote(candidate,final,metadata=(target,b"new dates"))
+            self.assertEqual((final/"value").read_text(),"old")
+            self.assertEqual(target.read_bytes(),b"old dates")
+
+    def test_dates_are_saved_with_successful_release(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp);candidate=root/".v2-candidate-test";candidate.mkdir()
+            target=root/"metadata/release-dates.json"
+            promote(candidate,root/"v2",metadata=(target,b"recorded dates"))
+            self.assertEqual(target.read_bytes(),b"recorded dates")
+
+    def test_success_preserves_previous_release(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp);final=root/"v2";candidate=root/".v2-candidate-test"
+            final.mkdir();candidate.mkdir()
+            (final/"value").write_text("old");(candidate/"value").write_text("new")
+            promote(candidate,final)
+            self.assertEqual((final/"value").read_text(),"new")
+            self.assertEqual((root/".v2-previous/value").read_text(),"old")
+
+    def test_promotion_failure_restores_current_and_previous(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp);final=root/"v2";candidate=root/".v2-candidate-test"
+            previous=root/".v2-previous"
+            for path in (final,candidate,previous):path.mkdir()
+            (final/"value").write_text("old");(candidate/"value").write_text("new")
+            (previous/"value").write_text("older")
+            rename=Path.rename
+            def fail_candidate(path,target):
+                if path==candidate:raise OSError("injected rename failure")
+                return rename(path,target)
+            with patch.object(Path,"rename",fail_candidate):
+                with self.assertRaisesRegex(OSError,"injected"):promote(candidate,final)
+            self.assertEqual((final/"value").read_text(),"old")
+            self.assertEqual((previous/"value").read_text(),"older")
+
+    def test_same_pipeline_is_blocked_but_v1_v2_roots_are_independent(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            v1=Path(tmp)/"v1";v2=Path(tmp)/"v2"
+            with update_lock(v1),update_lock(v2):
+                parent,child=multiprocessing.Pipe(False)
+                process=multiprocessing.Process(target=attempt_lock,args=(str(v2),child))
+                process.start();self.assertTrue(parent.poll(5));self.assertEqual(parent.recv(),"blocked")
+                process.join(5);self.assertEqual(process.exitcode,0)
+
+
+if __name__=="__main__":unittest.main()
