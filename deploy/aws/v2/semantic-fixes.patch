+"""End-to-end failures run only in an explicitly marked isolated V2 workspace."""
+import hashlib
+import json
+import subprocess
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+from types import SimpleNamespace
+import update_all_v2 as runner
+
+ROOT=Path(__file__).resolve().parents[2]
+
+
+def release_hash():
+    h=hashlib.sha256()
+    for p in sorted((ROOT/'data/v2').rglob('*.json')):
+        h.update(str(p.relative_to(ROOT)).encode());h.update(p.read_bytes())
+    metadata=ROOT/'data/metadata/release-dates.json'
+    if metadata.exists():h.update(metadata.read_bytes())
+    return h.hexdigest()
+
+
+@unittest.skipUnless((ROOT/'.isolated-v2-test').is_file(),'Requires explicit isolated test marker')
+class FailureIsolationTests(unittest.TestCase):
+    def corrupt_and_run(self,file,change):
+        path=ROOT/file;before=path.read_bytes();release=release_hash()
+        try:
+            change(path)
+            result=subprocess.run(['python3','update_all_v2.py','--skip-fetch'],cwd=ROOT,
+                                  capture_output=True,text=True)
+            self.assertNotEqual(result.returncode,0,result.stdout[-1000:])
+            self.assertEqual(release_hash(),release)
+            self.assertFalse(list((ROOT/'data').glob('.v2-candidate-*')))
+        finally:
+            path.write_bytes(before)
+
+    def test_malformed_official_unit_keeps_last_successful_release(self):
+        self.corrupt_and_run('data/raw/unit.json',lambda p:p.write_text('{broken'))
+
+    def test_missing_subskill_keeps_last_successful_release(self):
+        def remove_child(path):
+            rows=json.loads(path.read_text())
+            parent=next(r for r in rows if r.get('subSkills'))
+            child=parent['subSkills'].split(',')[0].strip()
+            path.write_text(json.dumps([r for r in rows if r['skillCode']!=child]))
+        self.corrupt_and_run('data/raw/skill.json',remove_child)
+
+    def test_catalog_failure_after_compilation_does_not_promote(self):
+        def damage(path):
+            rows=json.loads(path.read_text());rows[0]['en']+='%N9';path.write_text(json.dumps(rows))
+        self.corrupt_and_run('data/locales/ui.json',damage)
+
+    def test_malformed_ability_number_cannot_be_coerced_to_zero(self):
+        def damage(path):
+            rows=json.loads(path.read_text())
+            row=next(r for r in rows if r.get("abilityType")=="ABILITY")
+            row["activeProbability"]="broken"
+            path.write_text(json.dumps(rows))
+        self.corrupt_and_run('data/raw/ability.json',damage)
+
+    def test_api_failure_prevents_compilation_and_promotion(self):
+        release=release_hash();actual=runner.run
+        def failed_api(command,**kwargs):
+            if any(str(x).endswith('api_db_to_raw.py') for x in command):
+                raise subprocess.CalledProcessError(5,command)
+            return actual(command,**kwargs)
+        with patch.object(runner,'run',failed_api):
+            with self.assertRaises(subprocess.CalledProcessError):
+                runner.execute(SimpleNamespace(skip_fetch=False,force_full_manifest=False,fetch_only=False))
+        self.assertEqual(release_hash(),release)
+
+
+if __name__=='__main__':unittest.main()
