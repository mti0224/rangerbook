+"""V2-owned release paths, process lock, and recoverable promotion."""
+from contextlib import contextmanager
+import fcntl
+import os
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[2]
+
+
+def output_dir():
+    path=Path(os.environ.get("RANGERBOOK_V2_OUTPUT_DIR",str(ROOT/"data/v2"))).resolve()
+    parent=(ROOT/"data").resolve()
+    if path.parent!=parent or not (path.name=="v2" or path.name.startswith(".v2-candidate-")):
+        raise ValueError("V2 output must be a release or candidate inside its own data directory")
+    return path
+
+
+@contextmanager
+def update_lock(root=ROOT):
+    """Reuse the shell's inherited descriptor, or lock direct Python invocations."""
+    path=root/"runtime/v2-update.lock"
+    path.parent.mkdir(parents=True,exist_ok=True)
+    inherited=False
+    try:
+        current=os.fstat(9)
+        expected=path.stat()
+        inherited=(current.st_dev,current.st_ino)==(expected.st_dev,expected.st_ino)
+    except OSError:
+        pass
+    if inherited:
+        fcntl.flock(9,fcntl.LOCK_EX|fcntl.LOCK_NB)
+        yield
+        return
+    with path.open("a") as lock:
+        fcntl.flock(lock.fileno(),fcntl.LOCK_EX|fcntl.LOCK_NB)
+        try:
+            yield
+        finally:
+            fcntl.flock(lock.fileno(),fcntl.LOCK_UN)
+
+
+def promote(candidate,final,metadata=None):
+    candidate=Path(candidate)
+    final=Path(final)
+    if candidate.parent.resolve()!=final.parent.resolve() or candidate==final:
+        raise ValueError("Release promotion requires sibling candidate and final directories")
+    previous=final.parent/".v2-previous"
+    archived=final.parent/".v2-previous-older"
+    if archived.exists():
+        raise RuntimeError("Unresolved archived release; refusing destructive promotion")
+    if previous.exists():
+        previous.rename(archived)
+    try:
+        if final.exists():
+            final.rename(previous)
+        try:
+            candidate.rename(final)
+            if metadata is not None:
+                target,content=metadata
+                target=Path(target)
+                pending=target.with_suffix(".pending")
+                try:
+                    target.parent.mkdir(parents=True,exist_ok=True)
+                    pending.write_bytes(content)
+                    pending.replace(target)
+                except BaseException:
+                    pending.unlink(missing_ok=True)
+                    final.rename(candidate)
+                    raise
+        except BaseException:
+            if previous.exists():
+                previous.rename(final)
+            raise
+    except BaseException:
+        if archived.exists():
+            archived.rename(previous)
+        raise
+    if archived.exists():
+        import shutil
+        shutil.rmtree(archived)
