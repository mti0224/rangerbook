+"""Publish refusal, recovery and V1/V2 races against a local bare Git remote."""
+import hashlib
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+import publish_v2 as publisher
+from scripts.v2.release import output_dir
+
+
+def command(*args):
+    return subprocess.run(list(args),check=True,capture_output=True,text=True).stdout.strip()
+
+
+class PublisherTests(unittest.TestCase):
+    def setUp(self):
+        self.directory=tempfile.TemporaryDirectory()
+        self.root=Path(self.directory.name)
+        self.remote=self.root/'remote.git';self.seed=self.root/'seed'
+        command('git','init','--bare','--initial-branch=main',str(self.remote))
+        command('git','clone',str(self.remote),str(self.seed))
+        command('git','-C',str(self.seed),'config','user.email','test@example.invalid')
+        command('git','-C',str(self.seed),'config','user.name','Isolated Test')
+        (self.seed/'res').mkdir();(self.seed/'res/V1-sentinel.json').write_text('{"version":1}\n')
+        command('git','-C',str(self.seed),'add','res')
+        command('git','-C',str(self.seed),'commit','-m','fixture V1')
+        command('git','-C',str(self.seed),'push','origin','main')
+        self.patches=[patch.object(publisher,'REPO',self.root/'publisher'),
+                      patch.object(publisher,'URL',str(self.remote)),
+                      patch.object(publisher,'OUTPUT',output_dir())]
+        for p in self.patches:p.start()
+        publisher.prepare()
+        publisher.git('config','user.name','Isolated V2 Test')
+        publisher.git('config','user.email','test@example.invalid')
+
+    def tearDown(self):
+        for p in reversed(self.patches):p.stop()
+        self.directory.cleanup()
+
+    def test_rejected_push_preserves_remote_then_can_retry(self):
+        before=command('git','--git-dir',str(self.remote),'rev-parse','main')
+        hook=self.remote/'hooks/pre-receive';hook.write_text('#!/bin/sh\nexit 1\n');hook.chmod(0o755)
+        with self.assertRaisesRegex(RuntimeError,'four safe retry'):publisher.publish()
+        self.assertEqual(command('git','--git-dir',str(self.remote),'rev-parse','main'),before)
+        hook.unlink();self.assertTrue(publisher.publish());self.assertFalse(publisher.publish())
+        value=command('git','--git-dir',str(self.remote),'show','main:res/V1-sentinel.json')
+        self.assertEqual(value,'{"version":1}')
+        self.assertFalse((publisher.REPO/'.git/rebase-merge').exists())
+
+    def test_racing_v1_commit_survives_v2_retry(self):
+        original=subprocess.run;first=True
+        def race(args,*a,**kw):
+            nonlocal first
+            if first and isinstance(args,list) and args[:3]==['git','-C',str(publisher.REPO)] and 'push' in args:
+                first=False
+                (self.seed/'res/V1-sentinel.json').write_text('{"version":2}\n')
+                for tail in [('add','res'),('commit','-m','concurrent V1'),('push','origin','main')]:
+                    original(['git','-C',str(self.seed),*tail],check=True,capture_output=True,text=True)
+            return original(args,*a,**kw)
+        with patch.object(subprocess,'run',race):self.assertTrue(publisher.publish())
+        self.assertFalse(first)
+        self.assertEqual(command('git','--git-dir',str(self.remote),'show','main:res/V1-sentinel.json'),'{"version":2}')
+        self.assertEqual(command('git','--git-dir',str(self.remote),'show','main:res/v2/manifest.json'),
+                         (publisher.OUTPUT/'manifest.json').read_text().strip())
+
+    def test_review_branch_publication_does_not_change_main(self):
+        command('git','-C',str(self.seed),'checkout','-b','review')
+        command('git','-C',str(self.seed),'push','origin','review')
+        before=command('git','--git-dir',str(self.remote),'rev-parse','main')
+        self.assertTrue(publisher.publish('review'))
+        self.assertEqual(command('git','--git-dir',str(self.remote),'rev-parse','main'),before)
+        self.assertEqual(command('git','--git-dir',str(self.remote),'show','review:res/V1-sentinel.json'),'{\"version\":1}')
+
+
+if __name__=='__main__':unittest.main()
